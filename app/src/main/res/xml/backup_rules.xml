<?xml version="1.0" encoding="utf-8"?>
<!--
    Pravila za auto-backup na uređajima do API 30.

    DataStore "settings" se NAMERNO izuzima: sadrži ključ is_premium_user, pa bi
    restore backup-a na drugom uređaju/nalogu dao premium bez kupovine.
    Premium status se posle instalacije ponovo utvrđuje iz Google Play Billing-a
    (BillingClientManager.queryExistingPurchases), tako da legitimni kupci ništa ne gube.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
