<?xml version="1.0" encoding="utf-8"?>
<!--
    Pravila za cloud backup i device-to-device transfer na API 31+.
    Videti backup_rules.xml za obrazloženje izuzimanja DataStore "settings".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
